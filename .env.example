# Pull request (or pass the URL as the first CLI argument)
PR_URL=https://github.com/acme/widgets/pull/42

# Configure only the token for the selected provider
GITHUB_TOKEN=
BITBUCKET_TOKEN=

# GitHub Copilot
COPILOT_GITHUB_TOKEN=

# Optional Jira Data Center context using a personal or bot account token
JIRA_BASE_URL=https://jira.example.com
JIRA_TOKEN=

# Review behavior
SOURCE_DIR=
PUBLISH=false
VERIFICATION_COMMANDS_JSON=[]
