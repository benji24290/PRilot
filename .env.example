# Pull request (or pass the URL as the first CLI argument)
PR_URL=https://github.com/acme/widgets/pull/42

# Configure only the token for the selected provider
GITHUB_TOKEN=
BITBUCKET_TOKEN=

# GitHub Copilot
COPILOT_GITHUB_TOKEN=

# Optional Jira context. JIRA_EMAIL enables Basic auth for Atlassian Cloud;
# without it, DiffLynx sends JIRA_TOKEN as a Bearer token.
JIRA_BASE_URL=https://acme.atlassian.net
JIRA_TOKEN=
JIRA_EMAIL=

# Review behavior
SOURCE_DIR=
PUBLISH=false
VERIFICATION_COMMANDS_JSON=[]
