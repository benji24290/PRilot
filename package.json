{
	"name": "prilot",
	"version": "0.3.0",
	"description": "Issue-aware pull request review agent for GitHub and Bitbucket",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/benji24290/PRilot.git"
	},
	"homepage": "https://github.com/benji24290/PRilot",
	"bugs": {
		"url": "https://github.com/benji24290/PRilot/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pull-request",
		"code-review",
		"jira",
		"github",
		"bitbucket",
		"agent"
	],
	"type": "module",
	"bin": {
		"prilot": "dist/bin.js"
	},
	"files": [
		"dist/bin.js"
	],
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"build": "bun build src/bin.ts --target=node --packages=external --minify --outfile=dist/bin.js",
		"prepack": "bun run build",
		"pack:check": "bun pm pack --dry-run --ignore-scripts",
		"review": "bun --env-file=.env run src/bin.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"check": "bun run typecheck && bun test && bun run build && bun run pack:check",
		"smoke:copilot": "bun run scripts/copilot-smoke.ts"
	},
	"dependencies": {
		"@github/copilot-sdk": "1.0.7",
		"@napi-rs/keyring": "2.0.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/node": "20.19.0",
		"typescript": "7.0.2"
	}
}
