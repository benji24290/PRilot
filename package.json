{
  "name": "difflynx",
  "version": "0.1.0",
  "description": "Issue-aware pull request review agent for GitHub and Bitbucket",
  "license": "MIT",
  "keywords": [
    "pull-request",
    "code-review",
    "jira",
    "github",
    "bitbucket",
    "agent"
  ],
  "type": "module",
  "bin": {
    "difflynx": "dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "pack:check": "bun pm pack --dry-run --ignore-scripts",
    "review": "bun --env-file=.env run src/bin.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build && bun run pack:check",
    "smoke:copilot": "bun run scripts/copilot-smoke.ts"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.0",
    "bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
